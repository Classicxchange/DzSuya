{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src scripts --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@openzeppelin/contracts": "5.6.1",
    "@tanstack/react-query": "^5.105.2",
    "@types/qrcode": "^1.5.6",
    "@web3icons/react": "^4.1.24",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
